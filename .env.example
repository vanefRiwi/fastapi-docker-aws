# Opcional: docker compose funciona sin este archivo usando estos mismos valores por defecto.
# Si quieres cambiarlos, copia este archivo como .env y edítalo.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=inventario

# Solo para correr la app FUERA de Docker (uv run fastapi dev main.py) contra el Postgres del contenedor:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inventario
