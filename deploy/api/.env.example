# IP PRIVADA de la EC2 de PostgreSQL (ej. 10.0.2.x) y las credenciales de deploy/postgres/.env
DATABASE_URL=postgresql://app_user:CAMBIA_ESTA_CLAVE_por_una_larga_y_segura@10.0.2.XX:5432/inventario
S3_BUCKET_NAME=nombre-de-tu-bucket
AWS_REGION=us-east-1
# NO pongas AWS_ACCESS_KEY_ID ni AWS_SECRET_ACCESS_KEY: la EC2 usa un IAM Role
